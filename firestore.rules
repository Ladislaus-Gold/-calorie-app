rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Проверка продукта общей базы: набор полей, типы и разумные пределы
    function validProduct(d) {
      return d.keys().hasOnly(['name', 'brand', 'barcode', 'kcal', 'protein', 'fat', 'carbs',
                               'source', 'createdBy', 'createdByName', 'createdAt', 'updatedAt',
                               'drink', 'hydrationPct', 'caffeineMg100'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.brand is string && d.brand.size() <= 80
        && d.barcode is string && d.barcode.size() <= 20
        && d.kcal is number && d.kcal >= 0 && d.kcal <= 1000
        && d.protein is number && d.protein >= 0 && d.protein <= 100
        && d.fat is number && d.fat >= 0 && d.fat <= 100
        && d.carbs is number && d.carbs >= 0 && d.carbs <= 100
        && d.source is string
        && d.createdByName is string && d.createdByName.size() <= 60
        && (!('drink' in d) || d.drink is bool)
        && (!('hydrationPct' in d) || (d.hydrationPct is number && d.hydrationPct >= -400 && d.hydrationPct <= 200))
        && (!('caffeineMg100' in d) || (d.caffeineMg100 is number && d.caffeineMg100 >= 0 && d.caffeineMg100 <= 1000));
    }

    // Личные данные (дневник, цель): видит и меняет только владелец
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Общая база продуктов: читают все вошедшие пользователи,
    // добавляют любой, а менять и удалять может только автор
    match /products/{productId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && validProduct(request.resource.data);
      allow update: if request.auth != null
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && validProduct(request.resource.data);
      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
    }

    // Штрих-коды других упаковок: id документа = код, значение = id продукта.
    // Читают все вошедшие, добавляет любой, убрать может только добавивший
    match /barcodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['productId', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0 && request.resource.data.productId.size() <= 40
        && code.size() >= 6 && code.size() <= 20;
      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
    }
  }
}
