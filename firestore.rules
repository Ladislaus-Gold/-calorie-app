rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Проверка продукта общей базы: набор полей, типы и разумные пределы
    function validProduct(d) {
      return d.keys().hasOnly(['name', 'brand', 'barcode', 'kcal', 'protein', 'fat', 'carbs',
                               'source', 'createdBy', 'createdByName', 'createdAt', 'updatedAt',
                               'drink', 'hydrationPct', 'caffeineMg100',
                               'category', 'emoji', 'color'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.brand is string && d.brand.size() <= 80
        && d.barcode is string && d.barcode.size() <= 20
        && d.kcal is number && d.kcal >= 0 && d.kcal <= 1000
        && d.protein is number && d.protein >= 0 && d.protein <= 100
        && d.fat is number && d.fat >= 0 && d.fat <= 100
        && d.carbs is number && d.carbs >= 0 && d.carbs <= 100
        && d.source is string
        && d.createdByName is string && d.createdByName.size() <= 60
        && (!('category' in d) || (d.category is string && d.category.size() <= 40))
        && (!('emoji' in d) || (d.emoji is string && d.emoji.size() <= 16))
        && (!('color' in d) || (d.color is string && d.color.size() <= 32))
        && (!('drink' in d) || d.drink is bool)
        && (!('hydrationPct' in d) || (d.hydrationPct is number && d.hydrationPct >= -400 && d.hydrationPct <= 200))
        && (!('caffeineMg100' in d) || (d.caffeineMg100 is number && d.caffeineMg100 >= 0 && d.caffeineMg100 <= 1000));
    }

    // Проверка напитка общей базы
    function validDrink(d) {
      return d.keys().hasOnly(['n', 'h', 'c', 'cat', 'a', 'k', 'p', 'f', 'cb', 'bc', 'e', 'col',
                               'createdBy', 'createdByName', 'createdAt', 'updatedAt'])
        && (!('e' in d) || (d.e is string && d.e.size() <= 12))
        && (!('col' in d) || (d.col is string && d.col.size() <= 20))
        && d.n is string && d.n.size() > 0 && d.n.size() <= 120
        && d.h is number && d.h >= -400 && d.h <= 200
        && d.c is number && d.c >= 0 && d.c <= 2400
        && d.cat is string && d.cat.size() <= 20
        && d.a is string && d.a.size() <= 40
        && d.k is number && d.k >= 0 && d.k <= 1000
        && d.p is number && d.p >= 0 && d.p <= 100
        && d.f is number && d.f >= 0 && d.f <= 100
        && d.cb is number && d.cb >= 0 && d.cb <= 100
        && d.bc is list && d.bc.size() <= 12
        && d.createdByName is string && d.createdByName.size() <= 60;
    }

    // Личные данные (дневник, цель): видит и меняет только владелец
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Общая база продуктов: читают, добавляют, меняют и удаляют все вошедшие пользователи (с v2.2)
    match /products/{productId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && validProduct(request.resource.data);
      allow update: if request.auth != null
        && request.resource.data.createdBy == resource.data.createdBy
        && validProduct(request.resource.data);
      allow delete: if request.auth != null;
    }

    // Общая база напитков (как и продукты): читают, добавляют, меняют и удаляют все вошедшие (с v2.2)
    match /drinkdb/{drinkId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && validDrink(request.resource.data);
      allow update: if request.auth != null
        && request.resource.data.createdBy is string
        && validDrink(request.resource.data);
      allow delete: if request.auth != null;
    }

    // Штрих-коды других упаковок: id документа = код, значение = id продукта.
    // Читают, добавляют и убирают коды все вошедшие (с v2.2)
    match /barcodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['productId', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0 && request.resource.data.productId.size() <= 40
        && code.size() >= 6 && code.size() <= 20;
      allow delete: if request.auth != null;
    }
  }
}
